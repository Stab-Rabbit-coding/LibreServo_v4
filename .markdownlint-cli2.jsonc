{
  // markdownlint-cli2 config — see https://github.com/DavidAnson/markdownlint
  // Mirrors the sister Open-Secure-ESC project so both repos lint alike.
  "config": {
    "default": true,
    // REFERENCES.md follows IEEE citation style with long URLs and titles on a
    // single line by design; wrapping them would harm readability.
    "MD013": false,
    // Citation lists intentionally use bare URLs rather than link syntax.
    "MD034": false,
    // README.md and PCB/Gerbers/ReadMe.md are inherited from upstream
    // LibreServo and use inline HTML for logos and image layout. Rewriting
    // upstream presentation is out of scope for this fork.
    "MD033": false,
    "MD045": false,
    // Several inherited files (3D/README.md, the per-order Gerber ReadMe
    // fragments) open with a sentence rather than a heading. They are upstream
    // notes, not documents this fork authored.
    "MD041": false
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**"]
}
